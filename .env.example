OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PORT=8000
# MAX_RETRIES=10

# LANのスマホ通知には、各端末で信頼した証明書を使ったHTTPSが必要です。
# 自己署名CA・証明書の準備とパスの設定: node scripts/setup-https.cjs --configure
# 以下のパスは、任意のPEM証明書・秘密鍵へ差し替え可能です。
# HTTPS_CERT_FILE=certs/lan-cert.pem
# HTTPS_KEY_FILE=certs/lan-key.pem
# HTTPダウンロード用の公開CA証明書（PEM/DER。未指定なら certs/rootCA.pem）
# HTTPS_CA_CERT_FILE=certs/rootCA.pem
# HTTPS使用時の証明書配布専用HTTPポート（既定は PORT + 1。off で無効）
# CERT_HTTP_PORT=8001
# 通知サービスに渡す連絡先（任意）。HTTPSでの登録時はそのオリジンを既定値に使います。
# WEB_PUSH_SUBJECT=mailto:you@example.com
